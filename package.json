{
  "name": "bridge-cli",
  "version": "0.1.0",
  "description": "Automated, non-breaking dependency updates. One command. One PR.",
  "type": "module",
  "bin": {
    "bridge": "./bin/bridge.js",
    "bridge-cli": "./bin/bridge.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "action.yml",
    "build-info.json",
    "scripts/bridge-daily.sh",
    "scripts/schedule",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/bridge.js",
    "smoke": "node ./bin/bridge.js --help",
    "test": "node --import ./scripts/setup-bridge-home.js --test 'test/**/*.test.js'",
    "pg:generate": "node proving-ground/scripts/generate.mjs",
    "pg:provision": "node proving-ground/scripts/provision.mjs",
    "pg:reset": "node proving-ground/scripts/reset.mjs",
    "pg:dispatch": "node proving-ground/scripts/dispatch.mjs",
    "pg:collect": "node proving-ground/scripts/collect.mjs",
    "pg:score": "node proving-ground/scripts/score.mjs",
    "pg:pull": "node proving-ground/scripts/pull-data.mjs",
    "prepack": "node ./scripts/write-build-info.js",
    "postpack": "node ./scripts/write-build-info.js --clean"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dependencies",
    "automation",
    "cli",
    "git",
    "devops"
  ],
  "license": "MIT",
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "ora": "^8.1.1",
    "prompts": "^2.4.2",
    "simple-git": "^3.36.0"
  }
}
