<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd example for a once-daily Bridge run.

  1. Copy this file to ~/Library/LaunchAgents/com.bridge.daily.plist
  2. Replace every REPLACE_* value (repo URL, this checkout, config path, $HOME).
  3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.bridge.daily.plist
  4. launchctl enable gui/$(id -u)/com.bridge.daily
  5. launchctl kickstart -k gui/$(id -u)/com.bridge.daily   # optional immediate run

  The wrapper refuses overlapping runs of the same repo and exits non-zero on
  failure. It does not force a PR; Bridge still applies its normal gates.

  Alternative: `bridge schedule install --runner cli` writes a unit that calls
  `bridge schedule run` (multi-repo, daily digest, optional --notify). See
  docs/scheduling.md. This example is the modular runner approach.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bridge.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_PATH_TO_BRIDGE_CLI/scripts/bridge-daily.sh</string>
    <string>--repo</string>
    <string>REPLACE_GIT_URL_OR_CHECKOUT</string>
    <string>--branch</string>
    <string>main</string>
    <string>--config</string>
    <string>REPLACE_PATH_TO_BRIDGE_CONFIG</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_PATH_TO_BRIDGE_CLI</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>BRIDGE_HOME</key>
    <string>REPLACE_HOME/.bridge</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>REPLACE_HOME/.bridge/schedule/logs/daily.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_HOME/.bridge/schedule/logs/daily.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
